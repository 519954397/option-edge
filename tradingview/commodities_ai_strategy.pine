//@version=6
strategy(
     "Jin10 AI Commodities Gate v1",
     overlay = true,
     initial_capital = 100000,
     currency = currency.USD,
     pyramiding = 0,
     commission_type = strategy.commission.percent,
     commission_value = 0.02,
     slippage = 2,
     process_orders_on_close = true,
     max_labels_count = 100)

// ───────────────────────── Asset profile ─────────────────────────
string assetMode = input.string("Auto", "Asset profile", options = ["Auto", "Oil", "Gold", "Silver"], group = "1. Asset")
bool useProfileDefaults = input.bool(true, "Use profile defaults", group = "1. Asset")

string symbolText = str.upper(syminfo.ticker + " " + syminfo.description)
bool looksOil = str.contains(symbolText, "USOIL") or str.contains(symbolText, "UKOIL") or str.contains(symbolText, "WTI") or str.contains(symbolText, "BRENT") or str.contains(symbolText, "XTI") or str.contains(symbolText, "XBR") or str.contains(symbolText, "CL1!")
bool looksGold = str.contains(symbolText, "XAU") or str.contains(symbolText, "GOLD") or str.contains(symbolText, "GC1!")
bool looksSilver = str.contains(symbolText, "XAG") or str.contains(symbolText, "SILVER") or str.contains(symbolText, "SI1!")
string autoAsset = looksOil ? "Oil" : looksGold ? "Gold" : looksSilver ? "Silver" : "Unknown"
string asset = assetMode == "Auto" ? autoAsset : assetMode
bool supportedAsset = asset != "Unknown"

// ───────────────────────── Signal engine ─────────────────────────
int manualBreakout = input.int(20, "Breakout length", minval = 5, maxval = 100, group = "2. Signal")
int manualFastEma = input.int(50, "Fast EMA", minval = 5, maxval = 200, group = "2. Signal")
int manualSlowEma = input.int(200, "Slow EMA", minval = 20, maxval = 500, group = "2. Signal")
int adxLength = input.int(14, "ADX DI length", minval = 5, maxval = 50, group = "2. Signal")
int adxSmoothing = input.int(14, "ADX smoothing", minval = 5, maxval = 50, group = "2. Signal")
float manualMinAdx = input.float(20.0, "Minimum ADX", minval = 5, maxval = 60, step = 0.5, group = "2. Signal")
string higherTimeframe = input.timeframe("240", "Higher timeframe", group = "2. Signal")
bool useVolumeFilter = input.bool(false, "Require above-average volume", tooltip = "CFD/spot volume may be broker-specific, so this is off by default.", group = "2. Signal")

int breakoutLength = useProfileDefaults ? (asset == "Silver" ? 30 : asset == "Gold" ? 24 : 20) : manualBreakout
int fastLength = useProfileDefaults ? (asset == "Silver" ? 34 : 50) : manualFastEma
int slowLength = useProfileDefaults ? (asset == "Oil" ? 150 : 200) : manualSlowEma
float minAdx = useProfileDefaults ? (asset == "Silver" ? 23.0 : asset == "Oil" ? 22.0 : 20.0) : manualMinAdx

float fastEma = ta.ema(close, fastLength)
float slowEma = ta.ema(close, slowLength)
float htfFast = request.security(syminfo.tickerid, higherTimeframe, ta.ema(close, fastLength), barmerge.gaps_off, barmerge.lookahead_off)
float htfSlow = request.security(syminfo.tickerid, higherTimeframe, ta.ema(close, slowLength), barmerge.gaps_off, barmerge.lookahead_off)
[diPlus, diMinus, adx] = ta.dmi(adxLength, adxSmoothing)
float rsi = ta.rsi(close, 14)
float atr = ta.atr(14)
float upperBreakout = ta.highest(high, breakoutLength)[1]
float lowerBreakout = ta.lowest(low, breakoutLength)[1]
float averageVolume = ta.sma(volume, 20)
bool volumeOk = not useVolumeFilter or na(volume) or na(averageVolume) or volume > averageVolume
bool longTrend = close > fastEma and fastEma > slowEma and htfFast > htfSlow and diPlus > diMinus
bool shortTrend = close < fastEma and fastEma < slowEma and htfFast < htfSlow and diMinus > diPlus
bool longSetup = longTrend and adx >= minAdx and rsi < 75 and ta.crossover(close, upperBreakout) and volumeOk
bool shortSetup = shortTrend and adx >= minAdx and rsi > 25 and ta.crossunder(close, lowerBreakout) and volumeOk

// ───────────────────── External AI/Jin10 gate ─────────────────────
// Pine cannot call arbitrary HTTP/MCP APIs. Copy the latest ai-brief decision
// into these inputs, or let an external execution service apply the gate.
string externalGate = input.string("Both", "Allowed direction", options = ["Both", "Long only", "Short only", "Pause"], group = "3. External gate")
float externalRisk = input.float(0.50, "Risk multiplier", minval = 0, maxval = 1, step = 0.05, group = "3. External gate")
bool pauseNow = input.bool(false, "Manual event pause", group = "3. External gate")
int gateValidUntil = input.time(timestamp("31 Dec 2030 23:59 +0000"), "Gate valid until", group = "3. External gate")
bool gateFresh = time_close <= gateValidUntil
bool longAllowed = externalGate == "Both" or externalGate == "Long only"
bool shortAllowed = externalGate == "Both" or externalGate == "Short only"
bool gateOpen = gateFresh and not pauseNow and externalGate != "Pause" and externalRisk > 0

// ───────────────────────── Risk controls ─────────────────────────
float baseRiskPct = input.float(0.50, "Base equity risk per trade (%)", minval = 0.05, maxval = 2.0, step = 0.05, group = "4. Risk")
float manualStopAtr = input.float(2.0, "Stop ATR multiplier", minval = 0.5, maxval = 6, step = 0.1, group = "4. Risk")
float rewardRisk = input.float(2.0, "Reward/risk target", minval = 0.5, maxval = 6, step = 0.1, group = "4. Risk")
float maxLeverage = input.float(2.0, "Maximum notional leverage", minval = 0.1, maxval = 10, step = 0.1, group = "4. Risk")
float quantityStep = input.float(0.01, "Quantity step", minval = 0.0001, step = 0.01, group = "4. Risk")
float maxDailyLossPct = input.float(2.0, "Pause after daily equity loss (%)", minval = 0.25, maxval = 10, step = 0.25, group = "4. Risk")
int maxTradesPerDay = input.int(3, "Maximum entries per day", minval = 1, maxval = 20, group = "4. Risk")

float stopAtr = useProfileDefaults ? (asset == "Silver" ? 2.4 : asset == "Oil" ? 2.2 : 2.0) : manualStopAtr
bool newDay = ta.change(time("D")) != 0
var float dayStartEquity = strategy.equity
var int tradesToday = 0
if newDay
    dayStartEquity := strategy.equity
    tradesToday := 0
float dailyReturnPct = dayStartEquity > 0 ? (strategy.equity / dayStartEquity - 1) * 100 : 0
bool dailyRiskOk = dailyReturnPct > -maxDailyLossPct and tradesToday < maxTradesPerDay

float stopDistance = atr * stopAtr
float pointValue = math.max(syminfo.pointvalue, 0.0000001)
float riskCash = strategy.equity * baseRiskPct / 100 * externalRisk
float riskQuantity = stopDistance > 0 ? riskCash / (stopDistance * pointValue) : 0
float leverageQuantity = close > 0 ? strategy.equity * maxLeverage / (close * pointValue) : 0
float orderQuantity = math.floor(math.min(riskQuantity, leverageQuantity) / quantityStep) * quantityStep
bool canEnter = supportedAsset and barstate.isconfirmed and gateOpen and dailyRiskOk and strategy.position_size == 0 and orderQuantity >= quantityStep
bool longSignal = canEnter and longAllowed and longSetup
bool shortSignal = canEnter and shortAllowed and shortSetup

var float activeStop = na
var float activeTarget = na

f_alert(string side, float stopPrice, float targetPrice) =>
    string payload = "{\"source\":\"jin10-ai-commodities-v1\""
    payload += ",\"asset\":\"" + str.lower(asset) + "\""
    payload += ",\"symbol\":\"" + syminfo.tickerid + "\""
    payload += ",\"timeframe\":\"" + timeframe.period + "\""
    payload += ",\"side\":\"" + side + "\""
    payload += ",\"bar_time\":" + str.tostring(time_close)
    payload += ",\"price\":" + str.tostring(close, format.mintick)
    payload += ",\"stop\":" + str.tostring(stopPrice, format.mintick)
    payload += ",\"target\":" + str.tostring(targetPrice, format.mintick)
    payload += ",\"atr\":" + str.tostring(atr, format.mintick)
    payload += ",\"rsi\":" + str.tostring(rsi, "#.##")
    payload += ",\"adx\":" + str.tostring(adx, "#.##") + "}"
    payload

if longSignal
    activeStop := close - stopDistance
    activeTarget := close + stopDistance * rewardRisk
    string message = f_alert("long", activeStop, activeTarget)
    strategy.entry("Long", strategy.long, qty = orderQuantity, alert_message = message)
    alert(message, alert.freq_once_per_bar_close)
    tradesToday += 1

if shortSignal
    activeStop := close + stopDistance
    activeTarget := close - stopDistance * rewardRisk
    string message = f_alert("short", activeStop, activeTarget)
    strategy.entry("Short", strategy.short, qty = orderQuantity, alert_message = message)
    alert(message, alert.freq_once_per_bar_close)
    tradesToday += 1

if strategy.position_size > 0
    strategy.exit("Long exit", "Long", stop = activeStop, limit = activeTarget)
if strategy.position_size < 0
    strategy.exit("Short exit", "Short", stop = activeStop, limit = activeTarget)
if strategy.position_size == 0 and strategy.position_size[1] != 0
    activeStop := na
    activeTarget := na

// ───────────────────────── Visual layer ──────────────────────────
plot(fastEma, "Fast EMA", color = color.new(color.teal, 0), linewidth = 1)
plot(slowEma, "Slow EMA", color = color.new(color.orange, 0), linewidth = 2)
plot(upperBreakout, "Prior breakout high", color = color.new(color.green, 70), style = plot.style_linebr)
plot(lowerBreakout, "Prior breakout low", color = color.new(color.red, 70), style = plot.style_linebr)
plot(strategy.position_size != 0 ? activeStop : na, "Active stop", color = color.red, linewidth = 2, style = plot.style_linebr)
plot(strategy.position_size != 0 ? activeTarget : na, "Active target", color = color.green, linewidth = 2, style = plot.style_linebr)
plotshape(longSignal, "Long signal", shape.triangleup, location.belowbar, color = color.lime, size = size.small, text = "L")
plotshape(shortSignal, "Short signal", shape.triangledown, location.abovebar, color = color.red, size = size.small, text = "S")
bgcolor(not gateOpen ? color.new(color.red, 92) : not dailyRiskOk ? color.new(color.orange, 90) : na, title = "Risk pause")

var table status = table.new(position.top_right, 2, 7, border_width = 1)
if barstate.islast
    color gateColor = gateOpen ? color.new(color.green, 20) : color.new(color.red, 15)
    table.cell(status, 0, 0, "Jin10 AI Gate", text_color = color.white, bgcolor = color.rgb(25, 35, 50))
    table.cell(status, 1, 0, asset, text_color = supportedAsset ? color.white : color.yellow, bgcolor = color.rgb(25, 35, 50))
    table.cell(status, 0, 1, "HTF trend")
    table.cell(status, 1, 1, htfFast > htfSlow ? "UP" : htfFast < htfSlow ? "DOWN" : "FLAT")
    table.cell(status, 0, 2, "ADX")
    table.cell(status, 1, 2, str.tostring(adx, "#.0") + " / " + str.tostring(minAdx, "#.0"))
    table.cell(status, 0, 3, "External gate")
    table.cell(status, 1, 3, externalGate, bgcolor = gateColor)
    table.cell(status, 0, 4, "Risk")
    table.cell(status, 1, 4, str.tostring(baseRiskPct * externalRisk, "#.##") + "%")
    table.cell(status, 0, 5, "Daily P/L")
    table.cell(status, 1, 5, str.tostring(dailyReturnPct, "#.##") + "%")
    table.cell(status, 0, 6, "Trades today")
    table.cell(status, 1, 6, str.tostring(tradesToday) + " / " + str.tostring(maxTradesPerDay))
