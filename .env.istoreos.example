# 默认只允许 iStoreOS 本机和代理容器访问。
# 若需要直接从家庭局域网访问，可改成 0.0.0.0；不要在路由器上把 8790 映射到公网。
OPTION_RADAR_BIND=127.0.0.1
OPTION_RADAR_REFRESH=10
OPTION_RADAR_RISK_FREE_RATE=0.015

# 启用 Tailscale profile 时填写一次性、可重复使用或带标签的 auth key。
TS_AUTHKEY=

# 启用 Cloudflare profile 时填写 remotely-managed Tunnel token。
CLOUDFLARE_TUNNEL_TOKEN=
